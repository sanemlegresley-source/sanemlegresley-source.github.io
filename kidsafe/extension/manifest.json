{
  "manifest_version": 3,
  "name": "KidSafe Start",
  "version": "1.0.0",
  "description": "A friendly start page with parent-approved websites, plus usage reports the parent can view remotely.",
  "background": { "service_worker": "background.js", "type": "module" },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "options_page": "options.html",
  "action": { "default_title": "KidSafe Start", "default_icon": { "32": "icons/icon32.png", "128": "icons/icon128.png" } },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "tabs", "alarms", "idle", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    { "resources": ["blocked.html", "blocked.js", "pages.css"], "matches": ["<all_urls>"] }
  ]
}
